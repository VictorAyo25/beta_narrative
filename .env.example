# Firebase Configuration
# Get these values from your Firebase Console > Project Settings > General > Your apps > Web app
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Firebase Admin SDK (for server-side operations)
# Get these from your Firebase Console > Project Settings > Service Accounts > Generate new private key
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_email=your_service_account_email
FIREBASE_PRIVATE_KEY="your_private_key_with_newlines"

# SMTP relay for contact-form notifications.
# Defaults to Gmail when SMTP_HOST is unset. For Gmail, enable 2-Step
# Verification then create an App Password at:
# Google Account > Security > 2-Step Verification > App passwords
GMAIL_SMTP_USER=your_gmail@gmail.com
GMAIL_SMTP_PASSWORD=your_gmail_app_password

# Any other relay (Brevo, Resend, Mailjet) — set these instead of the GMAIL_ pair.
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=your_relay_login
# SMTP_PASSWORD=your_relay_key

# Who receives application notifications. Comma-separated for more than one.
CONTACT_EMAIL_TO=favour@example.com, you@example.com

# Who the notification appears to be FROM.
# Gmail only honours this if the SMTP account owns the address, or has verified
# it under Settings > Accounts > "Send mail as". Otherwise Gmail silently
# rewrites the From header back to GMAIL_SMTP_USER.
# Leave unset to send as GMAIL_SMTP_USER.
MAIL_FROM_ADDRESS=favour@example.com
MAIL_FROM_NAME=Beta Narrative

# Google Sheets API (for logging form submissions)
# Follow setup instructions in README.md
GOOGLE_SHEETS_PRIVATE_KEY="your_google_service_account_private_key"
GOOGLE_SHEETS_CLIENT_EMAIL=your_google_service_account_email
GOOGLE_SHEETS_ID=your_google_sheet_id
